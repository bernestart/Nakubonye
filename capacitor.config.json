{
  "appId": "com.nakubonye.app",
  "appName": "Nakubonye",
  "webDir": "dist",
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK"
    },
    "SafeArea": {
      "initialViewportFitCover": true
    },
    "SystemBars": {
      "insetsHandling": "native",
      "style": "DARK",
      "hidden": false
    },
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": true,
      "backgroundColor": "#0B0B14",
      "showSpinner": false
    }
  }
}